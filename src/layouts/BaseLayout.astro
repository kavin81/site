---
import "~/styles/globals.css";
import { config } from "~/lib/config";

const { meta } = Astro.props;

import BaseHead from "~/layouts/BaseHead.astro";

import Header from "~/components/layout/Header.astro";
import Footer from "~/components/layout/Footer.astro";
import CommandBar from "~/components/CommandBar";

const resolvedMeta = {
    title: meta?.title ?? config.siteTitle ?? config.siteName,
    description:
        meta?.description ?? config.siteDescription ?? config.siteTitle,
    publishedAt: meta?.publishedAt ?? meta?.modifiedAt,
};
---

<html lang="en">
    <BaseHead meta={resolvedMeta} />
    <body class="flex flex-col min-h-screen px-7.5 pt-5">
        <Header currentPath={Astro.url.pathname} />
        <!-- <CommandBar client:visible /> -->
        <main class="py-10">
            <slot />
        </main>
        <Footer />
    </body>
</html>
