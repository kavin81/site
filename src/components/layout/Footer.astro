---
import { Icon } from "astro-icon/components";
import { config } from "~/lib/config";

const commitHash = import.meta.env.VERCEL_GIT_COMMIT_SHA
    ? import.meta.env.VERCEL_GIT_COMMIT_SHA.slice(0, 7)
    : "199e7f1";

const divider = "ǀ";
---

<footer id="site-footer" class="mt-auto pt-5 pb-4 font-fira-code">
    <div
        class="mx-auto flex flex-col gap-6 md:flex-row md:justify-between md:items-center"
    >
        {/* Left */}
        <div class="flex flex-col gap-2 items-center md:items-start">
            <p class="text-sm">Copyright © 2025 Kavin.</p>

            <div class="flex items-center gap-1 text-sm">
                {
                    config.siteSocials.map((social, index) => (
                        <>
                            <a
                                href={social.url}
                                target="_blank"
                                rel="noopener"
                                class="underline decoration-1 underline-offset-2 transition-opacity hover:opacity-80"
                            >
                                {social.label}
                            </a>

                            {index < config.siteSocials.length - 1 && (
                                <span class="text-xs text-tertiary">
                                    {divider}
                                </span>
                            )}
                        </>
                    ))
                }
            </div>
        </div>

        {/* Right */}
        <div class="hidden md:flex flex-col gap-2 items-end">
            <a href="https://astro.build" target="_blank" rel="noopener">
                <img
                    src="/assets/built-with-astro.svg"
                    alt="Built with Astro"
                    width={120}
                    height={20}
                />
            </a>
            <a
                href={`https://github.com/${config.siteGiscus.repo}/tree/${commitHash}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-md border border-tertiary bg-muted/40 px-1.5 py-1 text-xs hover:bg-muted hover:border-foreground/20"
            >
                <Icon name="mdi:github" class="w-4 h-4" />
                <span class="text-xs text-tertiary">{divider}</span>
                {commitHash.slice(0, 7)}
            </a>
        </div>
    </div>
</footer>
