---
import { Icon } from "astro-icon/components";
---

<div>
    <h1 class="text-3xl">Hey, I'm Kavin</h1>
    <blockquote class="text-lg font-fira-code">
        <p>
            I'm a Sophomore @<span
                class="inline-flex items-center gap-1 mx-3 align-middle"
            >
                <Icon name="mdi:university" class="w-4 h-4" />
                <a
                    class="font-semibold underline decoration-tertiary underline-offset-2"
                    href="https://pes.edu/"
                >
                    PESU
                </a>
            </span>& fullstack developer
        </p>

        <p>
            Based in
            <span class="inline-flex items-center gap-1 mx-1 align-middle">
                <Icon name="mdi:navigation-variant" class="w-4.5 h-4.5" />
                <a
                    class="font-semibold underline decoration-tertiary underline-offset-2"
                    href="https://google.com/maps?q=Bengaluru"
                >
                    Bengaluru, India
                </a>
            </span>
        </p>
    </blockquote>

    <br />
    <br />
</div>
