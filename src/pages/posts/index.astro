---
import { getCollection } from "astro:content";

import BaseLayout from "~/layouts/BaseLayout.astro";

const posts = await getCollection("posts");
---

<BaseLayout>
    <ul>
        {
            posts.map(post => (
                <li>
                    <a href={`/post/${post.slug}`}>{post.data.title}</a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
